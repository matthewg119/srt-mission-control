// ═══════════════════════════════════════════════════════════════════════════
// Zoho CRM Custom Buttons — Sequence Enrollment
// ═══════════════════════════════════════════════════════════════════════════
//
// HOW TO SET UP IN ZOHO CRM:
// 1. Go to CRM → Setup → Customization → Modules and Fields → Leads
// 2. Click "Custom Buttons" → New Button
// 3. Set Name, Label, Placement (Detail View), and paste the Deluge code below
// 4. Repeat for each button
// 5. Make sure LEAD_ID used below is the Zoho Record ID (not a custom field)
//
// BASE URL: https://mission.srtagency.com/api/sequences/enroll
// STOP URL: https://mission.srtagency.com/api/sequences/stop
//
// ═══════════════════════════════════════════════════════════════════════════

// ── BUTTON 1: Add to FU Sequence ──────────────────────────────────────────
// Label: "📧 Add to FU Sequence"
// Placement: Detail View — Leads module

leadId = input.get("Lead ID").toString();
email = zoho.crm.getRecordById("Leads", leadId).get("Email");
firstName = zoho.crm.getRecordById("Leads", leadId).get("First Name");

if(email == null || email == "")
{
    info "No email address on this lead — cannot enroll.";
}
else
{
    payload = Map();
    payload.put("zoho_contact_id", leadId);
    payload.put("sequence_slug", "fu-new-inbound");
    payload.put("enrolled_by", "zoho_button");

    response = invokeurl
    [
        url: "https://mission.srtagency.com/api/sequences/enroll"
        type: POST
        parameters: payload.toString()
        headers: {"Content-Type":"application/json"}
    ];

    info response;
    if(response.get("enrolled") == true)
    {
        info firstName + " enrolled in FU Sequence. First email in ~5 min.";
    }
    else
    {
        info "Could not enroll: " + response.get("reason");
    }
}


// ── BUTTON 2: Add to Statements Sequence ─────────────────────────────────
// Label: "📧 Add to Statements Sequence"
// Placement: Detail View — Leads module

leadId = input.get("Lead ID").toString();

payload = Map();
payload.put("zoho_contact_id", leadId);
payload.put("sequence_slug", "awaiting-statements");
payload.put("enrolled_by", "zoho_button");

response = invokeurl
[
    url: "https://mission.srtagency.com/api/sequences/enroll"
    type: POST
    parameters: payload.toString()
    headers: {"Content-Type":"application/json"}
];

info response;


