// ── BUTTON 5: Stop All Sequences ──────────────────────────────────────────
// Label: "🛑 Stop All Sequences"
// Style: Danger (red)

leadId = input.get("Lead ID").toString();
firstName = zoho.crm.getRecordById("Leads", leadId).get("First Name");

payload = Map();
payload.put("zoho_contact_id", leadId);
payload.put("reason", "Manually stopped via Zoho button");

response = invokeurl
[
    url: "https://mission.srtagency.com/api/sequences/stop"
    type: POST
    parameters: payload.toString()
    headers: {"Content-Type":"application/json"}
];

stopped = response.get("stopped");
info "Stopped " + stopped + " active sequence(s) for " + firstName;


// ═══════════════════════════════════════════════════════════════════════════
// AUTO-STOP WORKFLOW RULE (Zoho Workflow Automation)
// ═══════════════════════════════════════════════════════════════════════════
//
// This rule fires automatically when Lead_Status changes to a terminal value.
//
// Setup:
// 1. Go to CRM → Setup → Automation → Workflow Rules → New Rule
// 2. Module: Leads
// 3. Trigger: "Record Action" → "Field Update" → Field: Lead Status
// 4. Condition: Lead Status is any of:
//    Not Interested, DNQ, Take Off List, Dead Declined, Declined, Junk Lead,
//    Lost, Funded, Closed - Not Converted, Unresponsive, Bad Lead, Wrong Number,
//    Duplicate
// 5. Action: Custom Function (paste code below)
//
// Custom Function (Deluge):
// ─────────────────────────────────────────────────────────────────────────

leadId = input.get("Lead ID").toString();
leadStatus = zoho.crm.getRecordById("Leads", leadId).get("Lead Status");

payload = Map();
payload.put("zoho_contact_id", leadId);
payload.put("reason", "Zoho status changed to: " + leadStatus);

response = invokeurl
[
    url: "https://mission.srtagency.com/api/sequences/stop"
    type: POST
    parameters: payload.toString()
    headers: {"Content-Type":"application/json"}
];

info "Auto-stopped sequences for lead " + leadId + " — " + response.get("stopped") + " stopped.";
